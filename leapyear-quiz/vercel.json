{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "webinar.startleapyear.com" }],
      "destination": "/webinar",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/parents",
      "has": [{ "type": "host", "value": "webinar.startleapyear.com" }],
      "destination": "/ads-webinar.html"
    },
    { "source": "/parents", "destination": "/ads-webinar.html" },
    {
      "source": "/((?!api/|css/|assets/|.*\\..*).*)",
      "has": [{ "type": "host", "value": "webinar.startleapyear.com" }],
      "destination": "/classical-christian.html"
    },
    { "source": "/faithdriven", "destination": "/faithdriven.html" },
    { "source": "/brentwood", "destination": "/brentwood.html" },
    { "source": "/webinar", "destination": "/classical-christian.html" },
    { "source": "/results/:token", "destination": "/results.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "webinar.startleapyear.com" }],
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
